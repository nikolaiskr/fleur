# Ключ DeepSeek API (модель deepseek-chat). Без ключа букет собирает
# встроенный локальный композитор — с той же JSON-схемой.
# В продакшене вызывайте API через серверный прокси, чтобы ключ не попадал в браузер.
VITE_DEEPSEEK_API_KEY=

# Строка подключения к БД (в полной версии — SQLite через Prisma)
DATABASE_URL="file:./dev.db"
